# ─── ETS LAMP FALL — variables d'environnement ───────────────────────────────
# Local : copier ce fichier en .env
# Coolify : renseigner ces variables dans « Environment Variables » de la ressource.

# Base de données SQLite — dans Docker, pointe vers le volume persistant.
# (valeur par défaut déjà définie dans le Dockerfile, à laisser telle quelle)
DATABASE_URL=file:/app/data/lampfall.db

# Port d'écoute du serveur (Docker/Coolify : laisser 3000)
PORT=3000

# Fuseau horaire du serveur
TZ=Africa/Dakar

# Secret de signature des sessions — RECOMMANDÉ en production.
# Générer une valeur aléatoire :  openssl rand -hex 32
# (si vide : valeur interne par défaut, les sessions survivent aux redémarrages
#  uniquement tant que la variable ne change pas)
AUTH_SECRET=

# Mot de passe du compte administrateur créé au PREMIER démarrage
# (défaut si vide : admin123 — à changer ensuite dans Utilisateurs)
ADMIN_PASSWORD=
