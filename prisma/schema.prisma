generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Clients ────────────────────────────────────────────────────────────────

model Client {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  address     String?
  type        String   @default("PARTICULIER") // PARTICULIER | ENTREPRISE
  creditLimit Float    @default(0) // plafond de crédit (0 = illimité)
  notes       String?
  createdAt   DateTime @default(now())

  invoices Invoice[]
  orders   Order[]
}

// ─── Catégories (dynamiques) ────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  code      String   @unique // SANITAIRE, PLOMBERIE, …
  label     String // Affichage : Sanitaire, Plomberie, …
  createdAt DateTime @default(now())
}

// ─── Produits (catalogue) ───────────────────────────────────────────────────

model Product {
  id            String   @id @default(cuid())
  name          String
  reference     String?
  category      String // code catégorie (voir Category)
  image         String? // data-URL de l'image du produit
  purchasePrice Float    @default(0)
  salePrice     Float    @default(0)
  stock         Int      @default(0)
  unit          String   @default("pièce")
  minStock      Int      @default(0)
  createdAt     DateTime @default(now())

  movements StockMovement[]
}

// ─── Factures (vente + proforma) ────────────────────────────────────────────

model Invoice {
  id             String    @id @default(cuid())
  number         String    @unique
  type           String    @default("VENTE") // VENTE | PROFORMA
  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName     String    @default("")
  clientPhone    String?
  clientAddress  String?
  date           DateTime  @default(now())
  dueDate        DateTime?
  deliveryStatus String    @default("NON_LIVRE") // LIVRE | NON_LIVRE
  paymentStatus  String    @default("NON_PAYE") // PAYE | PARTIEL | NON_PAYE
  amountPaid     Float     @default(0)
  taxRate        Float     @default(18)
  totalHT        Float     @default(0)
  totalTTC       Float     @default(0)
  notes          String?
  createdAt      DateTime  @default(now())

  items    InvoiceItem[]
  payments Payment[]
}

model InvoiceItem {
  id            String  @id @default(cuid())
  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId     String?
  productName   String
  category      String?
  unit          String  @default("pièce")
  quantity      Float
  unitPrice     Float
  total         Float
  purchasePrice Float? // prix d'achat au moment de la vente (calcul de marge)
}

// ─── Factures d'achat (fournisseurs, avec pièce jointe) ─────────────────────

model Purchase {
  id         String   @id @default(cuid())
  number     String
  supplier   String
  supplierId String?
  supplierRef Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  date       DateTime @default(now())
  total      Float    @default(0)
  fileName   String?
  fileType   String?
  fileSize   Int?
  fileStored String?
  notes      String?
  createdAt  DateTime @default(now())

  items PurchaseItem[]
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  quantity    Float
  unitPrice   Float
  total       Float
}

// ─── Commandes prévisionnelles ──────────────────────────────────────────────

model Order {
  id           String    @id @default(cuid())
  number       String    @unique
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName   String    @default("")
  date         DateTime  @default(now())
  deliveryDate DateTime?
  status       String    @default("EN_COURS") // EN_COURS | CONFIRMEE | LIVREE | ANNULEE
  notes        String?
  createdAt    DateTime  @default(now())

  items OrderItem[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  category    String?
  unit        String  @default("pièce")
  quantity    Float
  unitPrice   Float
  total       Float
}

// ─── Immobilier (locataires & loyers) ───────────────────────────────────────

model Tenant {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  building    String // Immeuble (ex : Immeuble F)
  unit        String? // Logement / local occupé
  monthlyRent Float    @default(0) // Loyer mensuel
  notes       String?
  createdAt   DateTime @default(now())

  rents Rent[]
}

model Rent {
  id       String    @id @default(cuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  month    String // AAAA-MM (ex : 2026-07)
  amount   Float     @default(0)
  status   String    @default("NON_PAYE") // PAYE | NON_PAYE
  paidAt   DateTime?
  notes    String?
  createdAt DateTime @default(now())

  @@unique([tenantId, month])
}

// ─── Achats à crédit (factures / proformas transférées) ─────────────────────

model CreditPurchase {
  id          String    @id @default(cuid())
  destination String // COMMERCANT | IMMO
  sourceType  String // VENTE | PROFORMA (type du document d'origine)
  sourceId    String    @unique // un document ne peut être transféré qu'une fois
  number      String // numéro du document d'origine
  tier        String // commerçant / bailleur concerné
  total       Float     @default(0)
  amountPaid  Float     @default(0)
  dueDate     DateTime?
  note        String?
  createdAt   DateTime  @default(now())

  payments CreditPayment[]
}

model CreditPayment {
  id         String         @id @default(cuid())
  purchaseId String
  purchase   CreditPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  amount     Float
  method     String         @default("ESPECES") // ESPECES | WAVE | ORANGE_MONEY | FREE_MONEY | VIREMENT | CHEQUE
  paidAt     DateTime       @default(now())
  note       String?
  createdAt  DateTime       @default(now())
}

// ─── Versements (paiements multiples par facture) ───────────────────────────

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  method    String   @default("ESPECES") // ESPECES | WAVE | ORANGE_MONEY | FREE_MONEY | VIREMENT | CHEQUE
  paidAt    DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())
}

// ─── Fournisseurs ───────────────────────────────────────────────────────────

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())

  purchases Purchase[]
}

// ─── Mouvements de stock (journal) ──────────────────────────────────────────

model StockMovement {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        String // ENTREE | SORTIE | AJUSTEMENT
  quantity    Float
  stockBefore Float
  stockAfter  Float
  reason      String?
  refType     String? // ACHAT | VENTE | MANUEL | INITIAL
  refId       String?
  userName    String?
  createdAt   DateTime @default(now())
}

// ─── Journal d'audit ────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String // CREATE | UPDATE | DELETE
  entity    String // Invoice | Client | Product | Purchase | Supplier | Payment | Tenant | Rent | User | Settings | Stock
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}

// ─── Paramètres société (injectés dans les factures) ────────────────────────

model Setting {
  id          String  @id @default("main")
  nomSociete  String  @default("ETS LAMP FALL")
  tagline     String  @default("Plomberie - Sanitaire - Luminaire")
  adresse     String  @default("Dakar, Sénégal")
  telephone   String  @default("+221 77 000 00 00")
  email       String  @default("contact@etslampfall.sn")
  rc          String  @default("")
  ninea       String  @default("")
  logo        String? // data-URL du logo personnalisé
  // Configuration boîte mail (SMTP envoi / IMAP réception)
  mailFromName String  @default("ETS LAMP FALL")
  smtpHost    String  @default("")
  smtpPort    Int     @default(587)
  smtpUser    String  @default("")
  smtpPass    String  @default("")
  smtpSecure  Boolean @default(false) // true = TLS direct (port 465)
  imapHost    String  @default("")
  imapPort    Int     @default(993)
  imapUser    String  @default("")
  imapPass    String  @default("")
  lastMailSync DateTime?
  updatedAt   DateTime @updatedAt
}

// ─── Utilisateurs (admin / employés) ────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  password     String // hash scrypt : sel:clé
  role         String   @default("EMPLOYE") // ADMIN | EMPLOYE
  actif        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Boîte mail (réception IMAP + envoi SMTP) ───────────────────────────────

model Mail {
  id        String   @id @default(cuid())
  direction String   @default("IN") // IN = reçu | OUT = envoyé
  folder    String   @default("INBOX") // INBOX | SENT | TRASH
  fromName  String?
  from      String
  to        String
  subject   String   @default("")
  body      String   @default("")
  messageId String? // identifiant serveur (dédoublonnage IMAP)
  read      Boolean  @default(false)
  starred   Boolean  @default(false)
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())
}

// ─── Calendrier (événements / rendez-vous) ──────────────────────────────────

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  startTime   String? // HH:mm
  endTime     String? // HH:mm
  color       String   @default("green") // green | gold | orange | red
  type        String   @default("RDV") // RDV | TACHE | RAPPEL
  done        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ─── QR Tags (historique QRtag.net + QRBags) ────────────────────────────────

model QrLookup {
  id        String   @id @default(cuid())
  provider  String // QRTAG | QRBAGS
  query     String // URL encodée (QRTAG) ou référence (QRBAGS)
  options   String? // JSON : format / taille / transparent
  result    String? // JSON résultat normalisé
  status    String   @default("OK") // OK | ERREUR
  createdAt DateTime @default(now())
}
