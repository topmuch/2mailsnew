generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Clients ────────────────────────────────────────────────────────────────

model Client {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  address     String?
  type        String   @default("PARTICULIER") // PARTICULIER | ENTREPRISE
  creditLimit Float    @default(0) // plafond de crédit (0 = illimité)
  notes       String?
  createdAt   DateTime @default(now())

  invoices Invoice[]
  orders   Order[]
}

// ─── Catégories (dynamiques) ────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  code      String   @unique // SANITAIRE, PLOMBERIE, …
  label     String // Affichage : Sanitaire, Plomberie, …
  createdAt DateTime @default(now())
}

// ─── Produits (catalogue) ───────────────────────────────────────────────────

model Product {
  id            String   @id @default(cuid())
  name          String
  reference     String?
  category      String // code catégorie (voir Category)
  image         String? // data-URL de l'image du produit
  purchasePrice Float    @default(0)
  salePrice     Float    @default(0)
  stock         Int      @default(0)
  unit          String   @default("pièce")
  minStock      Int      @default(0)
  createdAt     DateTime @default(now())

  movements StockMovement[]
}

// ─── Factures (vente + proforma) ────────────────────────────────────────────

model Invoice {
  id             String    @id @default(cuid())
  number         String    @unique
  type           String    @default("VENTE") // VENTE | PROFORMA
  clientId       String?
  client         Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName     String    @default("")
  clientPhone    String?
  clientAddress  String?
  date           DateTime  @default(now())
  dueDate        DateTime?
  deliveryStatus String    @default("NON_LIVRE") // LIVRE | NON_LIVRE
  paymentStatus  String    @default("NON_PAYE") // PAYE | PARTIEL | NON_PAYE
  amountPaid     Float     @default(0)
  taxRate        Float     @default(18)
  totalHT        Float     @default(0)
  totalTTC       Float     @default(0)
  notes          String?
  createdAt      DateTime  @default(now())

  items    InvoiceItem[]
  payments Payment[]
}

model InvoiceItem {
  id            String  @id @default(cuid())
  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId     String?
  productName   String
  category      String?
  unit          String  @default("pièce")
  quantity      Float
  unitPrice     Float
  total         Float
  purchasePrice Float? // prix d'achat au moment de la vente (calcul de marge)
}

// ─── Factures d'achat (fournisseurs, avec pièce jointe) ─────────────────────

model Purchase {
  id         String   @id @default(cuid())
  number     String
  supplier   String
  supplierId String?
  supplierRef Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  date       DateTime @default(now())
  total      Float    @default(0)
  fileName   String?
  fileType   String?
  fileSize   Int?
  fileStored String?
  notes      String?
  createdAt  DateTime @default(now())

  items PurchaseItem[]
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  quantity    Float
  unitPrice   Float
  total       Float
}

// ─── Commandes prévisionnelles ──────────────────────────────────────────────

model Order {
  id           String    @id @default(cuid())
  number       String    @unique
  clientId     String?
  client       Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName   String    @default("")
  date         DateTime  @default(now())
  deliveryDate DateTime?
  status       String    @default("EN_COURS") // EN_COURS | CONFIRMEE | LIVREE | ANNULEE
  notes        String?
  createdAt    DateTime  @default(now())

  items OrderItem[]
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  category    String?
  unit        String  @default("pièce")
  quantity    Float
  unitPrice   Float
  total       Float
}

// ─── Versements (paiements multiples par facture) ───────────────────────────

model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  method    String   @default("ESPECES") // ESPECES | WAVE | ORANGE_MONEY | FREE_MONEY | VIREMENT | CHEQUE
  paidAt    DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())
}

// ─── Fournisseurs ───────────────────────────────────────────────────────────

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())

  purchases Purchase[]
}

// ─── Mouvements de stock (journal) ──────────────────────────────────────────

model StockMovement {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        String // ENTREE | SORTIE | AJUSTEMENT
  quantity    Float
  stockBefore Float
  stockAfter  Float
  reason      String?
  refType     String? // ACHAT | VENTE | MANUEL | INITIAL
  refId       String?
  userName    String?
  createdAt   DateTime @default(now())
}

// ─── Journal d'audit ────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String?
  action    String // CREATE | UPDATE | DELETE
  entity    String // Invoice | Client | Product | Purchase | Supplier | Payment | Tenant | Rent | User | Settings | Stock
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}

// ─── Paramètres société (injectés dans les factures) ────────────────────────

model Setting {
  id          String  @id @default("main")
  nomSociete  String  @default("2MAILS")
  tagline     String  @default("Plomberie - Sanitaire - Luminaire")
  adresse     String  @default("Dakar, Sénégal")
  telephone   String  @default("+221 77 000 00 00")
  email       String  @default("contact@2mails.sn")
  rc          String  @default("")
  ninea       String  @default("")
  logo        String? // data-URL du logo personnalisé
  // Configuration boîte mail (SMTP envoi / IMAP réception)
  mailFromName String  @default("2MAILS")
  smtpHost    String  @default("")
  smtpPort    Int     @default(587)
  smtpUser    String  @default("")
  smtpPass    String  @default("")
  smtpSecure  Boolean @default(false) // true = TLS direct (port 465)
  imapHost    String  @default("")
  imapPort    Int     @default(993)
  imapUser    String  @default("")
  imapPass    String  @default("")
  lastMailSync DateTime?
  updatedAt   DateTime @updatedAt
}

// ─── Utilisateurs (admin / employés) ────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  password     String // hash scrypt : sel:clé
  role         String   @default("EMPLOYE") // ADMIN | EMPLOYE
  actif        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Boîte mail (réception IMAP + envoi SMTP) ───────────────────────────────

model Mail {
  id        String   @id @default(cuid())
  direction String   @default("IN") // IN = reçu | OUT = envoyé
  folder    String   @default("INBOX") // INBOX | SENT | TRASH
  fromName  String?
  from      String
  to        String
  subject   String   @default("")
  body      String   @default("")
  messageId String? // identifiant serveur (dédoublonnage IMAP)
  read      Boolean  @default(false)
  starred   Boolean  @default(false)
  sentAt    DateTime @default(now())
  createdAt DateTime @default(now())
}

// ─── Calendrier (événements / rendez-vous) ──────────────────────────────────

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  startTime   String? // HH:mm
  endTime     String? // HH:mm
  color       String   @default("green") // green | gold | orange | red
  type        String   @default("RDV") // RDV | TACHE | RAPPEL
  done        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ─── CRM Unifié (synchro qrtags.pro + qrbags.com) ───────────────────────────
// Cache local des items/événements des deux plateformes, alimenté par
// webhooks (/api/crm/webhooks) et synchronisation manuelle (/api/crm/sync).

model CrmPlatform {
  id                 String    @id @default(cuid())
  name               String    @unique // QRTAGS | QRBAGS
  label              String    @default("") // ex. « qrtags.pro », « qrbags.com »
  apiUrl             String    @default("") // URL de base de l'API de la plateforme
  apiKey             String    @default("") // clé Bearer pour appeler l'API de la plateforme
  webhookSecret      String    @default("") // secret partagé pour valider les webhooks entrants
  estimatedPackPrice Float     @default(0) // prix estimé d'un pack vendu (FCFA) pour le revenu estimé du dashboard
  isActive           Boolean   @default(true)
  lastSyncAt         DateTime?
  createdAt          DateTime  @default(now())

  items CrmItem[]
}

model CrmItem {
  id            String      @id @default(cuid())
  platformId    String
  platform      CrmPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  externalId    String // ID du tag/bagage sur la plateforme source
  code          String      @default("") // référence lisible (ex. HAJJ25-ABC123)
  type          String      @default("TAG") // TAG | BAGAGE
  status        String      @default("ACTIVE") // ACTIVE | LOST | FOUND | SUSPENDED | INACTIVE
  ownerName     String?
  ownerPhone    String?
  ownerEmail    String?
  clientId      String? // lien optionnel vers un client CRM local
  lastScanAt    DateTime?
  lastScanPlace String?
  scanCount     Int         @default(0)
  raw           String? // JSON brut renvoyé par la plateforme
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  client CrmClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([platformId, externalId])
  @@index([platformId])
  @@index([status])
  @@index([type])
}

model CrmActivity {
  id        String    @id @default(cuid())
  platform  String // QRTAGS | QRBAGS
  itemId    String? // lien optionnel vers l'item concerné
  action    String // SCAN | ACTIVATION | LOST | FOUND | SUSPENDED | SYNC | WEBHOOK_ERROR
  details   String    @default("")
  timestamp DateTime  @default(now())

  @@index([timestamp])
  @@index([platform])
}

model CrmClient {
  id         String    @id @default(cuid())
  name       String
  email      String? // ex. contact client CRM (pas de contrainte unique : sync tolérante)
  phone      String?
  totalItems Int       @default(0) // nombre d'items liés (recalculé à la synchro)
  status     String    @default("ACTIVE") // ACTIVE | INACTIVE
  notes      String?
  createdAt  DateTime  @default(now())

  items    CrmItem[]
  projects CrmProject[]
}

// ─── CRM Commercial : leads (pipeline de prospection) et projets ────────────

model CrmLead {
  id        String   @id @default(cuid())
  name      String
  company   String?
  email     String?
  phone     String?
  source    String   @default("AUTRE") // QRTAGS | QRBAGS | RECOMMANDATION | SITE_WEB | AUTRE
  status    String   @default("NEW") // NEW | CONTACTED | QUALIFIED | PROPOSAL | WON | LOST
  value     Float    @default(0) // valeur estimée du deal (FCFA)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model CrmProject {
  id          String     @id @default(cuid())
  name        String
  description String?
  clientId    String?
  client      CrmClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  status      String     @default("PLANNING") // PLANNING | IN_PROGRESS | ON_HOLD | DONE | CANCELLED
  budget      Float      @default(0) // budget (FCFA)
  startDate   DateTime?
  endDate     DateTime?
  progress    Int        @default(0) // avancement 0-100
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status])
}

// ─── CRM Automatisations (rapports quotidiens, coach virtuel, rappels RDV) ──
// Planifiés par le scheduler interne (node-cron, démarré via instrumentation).
// Arrêt automatique le samedi à partir de 13h + dimanche (isBusinessHours).

model CrmTask {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("TODO") // TODO | IN_PROGRESS | DONE
  priority    String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([dueDate])
}

model CrmCoachMessage {
  id        String   @id @default(cuid())
  timeSlot  String // "11h" | "14h" | "17h"
  category  String @default("BUSINESS") // BUSINESS | MINDSET | CLOSING
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([timeSlot])
}

model CrmSentMessage {
  id        String   @id @default(cuid())
  type      String // REPORT_MORNING | REPORT_EVENING | COACH | REMINDER | TEST
  subject   String   @default("")
  content   String   @default("") // extrait ou contenu complet envoyé
  channel   String   @default("EMAIL") // EMAIL | WHATSAPP
  dedupeKey String? // clé d'idempotence (1 envoi max par créneau/jour/événement)
  status    String   @default("SENT") // SENT | FAILED | SKIPPED
  error     String?
  sentAt    DateTime @default(now())

  @@unique([type, dedupeKey])
  @@index([sentAt])
  @@index([type])
}

model CrmAutomationConfig {
  id                   String   @id @default("main")
  ownerName            String   @default("Monsieur Diop") // personnalisation coach
  recipientEmail       String   @default("") // vide → e-mail de la société (Setting)
  reportMorningEnabled Boolean  @default(true)
  reportMorningTime    String   @default("08:30") // HH:mm
  reportEveningEnabled Boolean  @default(true)
  reportEveningTime    String   @default("19:00") // HH:mm
  coachEnabled         Boolean  @default(true)
  coach11Enabled       Boolean  @default(true)
  coach14Enabled       Boolean  @default(true)
  coach17Enabled       Boolean  @default(true)
  remindersEnabled     Boolean  @default(true)
  dailyGoal            String   @default("") // objectif du jour (vide → objectif aléatoire)
  updatedAt            DateTime @updatedAt
}

// ─── QR Tags (historique QRtag.net + QRBags) ────────────────────────────────

model QrLookup {
  id        String   @id @default(cuid())
  provider  String // QRTAG | QRBAGS
  query     String // URL encodée (QRTAG) ou référence (QRBAGS)
  options   String? // JSON : format / taille / transparent
  result    String? // JSON résultat normalisé
  status    String   @default("OK") // OK | ERREUR
  createdAt DateTime @default(now())
}
